# ⚠️ FICHIER DE CONFIGURATION ENVIRONNEMENT - Hanout Price
# Ce fichier contient des clés API sensibles et NE DOIT PAS être commité sur Git
# Il est listé dans .gitignore

# ============================================================================
# 🤖 GEMINI AI - Reconnaissance de Produits (OBLIGATOIRE)
# ============================================================================
# Cette clé permet à l'IA de reconnaître les produits à partir de photos
# 
# Comment obtenir la clé :
# 1. Aller sur https://aistudio.google.com/app/apikey
# 2. Se connecter avec un compte Google
# 3. Cliquer sur "Create API Key"
# 4. Copier la clé et la coller ci-dessous
#
# Plan gratuit : 60 requêtes/minute, largement suffisant pour débuter
#
GEMINI_API_KEY=

# ============================================================================
# 🗺️ GOOGLE MAPS - Affichage Carte (OBLIGATOIRE)
# ============================================================================
# Cette clé permet d'afficher la carte interactive avec les magasins
#
# Comment obtenir la clé :
# 1. Aller sur https://console.cloud.google.com/google/maps-apis/credentials
# 2. Créer un projet ou sélectionner un projet existant
# 3. Cliquer sur "Create Credentials" > "API Key"
# 4. Activer les APIs suivantes :
#    - Maps JavaScript API
#    - Places API (optionnel, pour recherche de lieux)
# 5. Copier la clé et la coller ci-dessous
#
# NOTE : Préfixer avec NEXT_PUBLIC_ pour exposer côté client (sécurisé par domaine)
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================================================
# 🔍 ALGOLIA - Recherche de Produits (OPTIONNEL pour dev local)
# ============================================================================
# Ces clés sont déjà configurées dans functions/.env.local pour les Cloud Functions
# Si vous voulez tester la recherche localement, décommentez et remplissez :
#
# NEXT_PUBLIC_ALGOLIA_APP_ID=DP923KV3P6
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=votre_search_only_key_ici
#
# La Search Key est publique et sûre (lecture seule)
# Obtenir sur : https://www.algolia.com/account/api-keys

# ============================================================================
# 📊 ANALYTICS (OPTIONNEL)
# ============================================================================
# Si vous ajoutez Google Analytics, Firebase Analytics, etc.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ============================================================================
# 🚀 APRÈS CONFIGURATION
# ============================================================================
# 1. Sauvegarder ce fichier
# 2. Redémarrer le serveur : Ctrl+C puis 'npm run dev'
# 3. Tester sur http://localhost:9002/add-product
#
# Vérifier que :
# - La caméra fonctionne
# - L'IA reconnaît les produits après photo
# - La carte s'affiche sur /dashboard
